<mujoco model="object profiling suspended box">
  <include file="ur10e.xml"/>

  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>

  <visual>
    <headlight diffuse="0.65 0.65 0.65" ambient="0.25 0.25 0.25" specular="0.1 0.1 0.1"/>
    <global azimuth="125" elevation="-22"/>
    <map znear="0.01" zfar="5"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.75 0.82 0.9" rgb2="0.12 0.16 0.22" width="512" height="3072"/>
    <texture type="2d" name="floor_tex" builtin="checker" mark="edge" rgb1="0.5 0.52 0.55" rgb2="0.34 0.36 0.39" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="floor_mat" texture="floor_tex" texuniform="true" texrepeat="4 4" reflectance="0.05"/>
    <material name="belt_mat" rgba="0.12 0.14 0.17 1"/>
    <material name="frame_mat" rgba="0.15 0.17 0.2 1"/>
    <material name="cup_mat" rgba="0.08 0.1 0.12 1"/>
    <material name="box_mat" rgba="0.72 0.43 0.19 1"/>
  </asset>

  <worldbody>
    <light name="key_light" pos="0.2 0.3 2.5" dir="0 0 -1" directional="true" diffuse="0.8 0.8 0.8"/>
    <light name="fill_light" pos="1.5 1.5 1.4" dir="-1 -1 -0.4" directional="true" diffuse="0.45 0.45 0.45"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="floor_mat"/>

    <body name="conveyor" pos="0.65 -0.55 0.35">
      <geom name="belt" type="box" size="0.65 0.25 0.035" material="belt_mat" contype="1" conaffinity="1"/>
      <geom type="box" pos="0 -0.28 -0.18" size="0.65 0.035 0.18" material="frame_mat"/>
      <geom type="box" pos="0 0.28 -0.18" size="0.65 0.035 0.18" material="frame_mat"/>
    </body>

    <!-- Apoyo pasivo del checkpoint. Su cara superior coincide con la base de
         la caja nominal antes de activar la succion. -->
    <body name="pickup_support" pos="-0.174 0.691 0.405">
      <geom name="pickup_support_geom" type="box" size="0.23 0.18 0.05" material="frame_mat" friction="0.9 0.02 0.002"/>
    </body>

    <body name="error_bin" pos="-0.85 0.15 0.0">
      <!-- group 5: visible en el visor (se activa a proposito), oculta para
           scan_rgbd_cam, que solo renderiza los grupos 0-2 por defecto. -->
      <geom name="error_bin_floor" type="box" size="0.27 0.22 0.02" pos="0 0 0.02" material="frame_mat" group="5"/>
      <geom name="error_bin_wall_xp" type="box" size="0.02 0.22 0.12" pos="0.25 0 0.16" material="frame_mat" group="5"/>
      <geom name="error_bin_wall_xn" type="box" size="0.02 0.22 0.12" pos="-0.25 0 0.16" material="frame_mat" group="5"/>
      <geom name="error_bin_wall_yp" type="box" size="0.27 0.02 0.12" pos="0 0.20 0.16" material="frame_mat" group="5"/>
      <geom name="error_bin_wall_yn" type="box" size="0.27 0.02 0.12" pos="0 -0.20 0.16" material="frame_mat" group="5"/>
      <site name="error_zone_drop" pos="0 0 0.45" size="0.01" rgba="0.9 0.2 0.1 1"/>
    </body>

    <body name="scan_target" pos="-0.174 0.735 0.650"/>
    <camera name="scan_rgbd_cam" mode="targetbody" target="scan_target" pos="0.5566 1.22835 0.38025" fovy="50" resolution="640 480"/>
    <body name="scan_camera_housing" pos="0.6042 1.2605 0.3978">
      <geom name="scan_camera_housing_geom" type="box" size="0.045 0.035 0.030" material="frame_mat" contype="0" conaffinity="0"/>
    </body>
    <camera name="infeed_rgbd_cam" mode="targetbody" target="conveyor" pos="0.65 -0.55 1.85" fovy="55" resolution="640 480"/>

    <body name="profiling_gripper" pos="0 0 2">
      <freejoint name="gripper_free"/>
      <inertial pos="0 0 0.025" mass="0.75" diaginertia="0.003 0.003 0.004"/>
      <geom name="gripper_hub" type="cylinder" size="0.032 0.025" pos="0 0 0.025" material="frame_mat" contype="0" conaffinity="0"/>
      <geom name="gripper_beam_x" type="box" size="0.078 0.009 0.008" pos="0 0 0.055" material="frame_mat" contype="0" conaffinity="0"/>
      <geom name="gripper_beam_y" type="box" size="0.009 0.063 0.008" pos="0 0 0.055" material="frame_mat" contype="0" conaffinity="0"/>
      <geom name="cup_center" type="cylinder" size="0.020 0.012" pos="0 0 0.077" material="cup_mat" contype="0" conaffinity="0"/>
      <geom name="cup_x_pos" type="cylinder" size="0.020 0.012" pos="0.055 0 0.077" material="cup_mat" contype="0" conaffinity="0"/>
      <geom name="cup_x_neg" type="cylinder" size="0.020 0.012" pos="-0.055 0 0.077" material="cup_mat" contype="0" conaffinity="0"/>
      <geom name="cup_y_pos" type="cylinder" size="0.020 0.012" pos="0 0.040 0.077" material="cup_mat" contype="0" conaffinity="0"/>
      <geom name="cup_y_neg" type="cylinder" size="0.020 0.012" pos="0 -0.040 0.077" material="cup_mat" contype="0" conaffinity="0"/>
      <site name="gripper_tcp" pos="0 0 0.089" size="0.005" rgba="0.1 0.9 0.2 1"/>
    </body>

    <body name="profiling_box" pos="0 0 1.5">
      <freejoint name="box_free"/>
      <inertial pos="0 0 0" mass="2" diaginertia="0.02 0.03 0.04"/>
      <!-- Visual: se sustituye por malla en runtime. group 2 se renderiza. -->
      <geom name="box_geom" type="box" size="0.15 0.10 0.075" material="box_mat" contype="0" conaffinity="0" group="2"/>
      <!-- Colision del envolvente. group 3 no se renderiza por defecto, asi que
           el dano visible no se tapa con una primitiva, y load_box puede seguir
           ajustando geom_size sin recompilar. El casco convexo de una malla
           hundida coincidiria con este envolvente (R2 del plan). -->
      <geom name="box_collision" type="box" size="0.15 0.10 0.075" rgba="1 0 0 0" friction="0.8 0.02 0.002" contype="1" conaffinity="1" group="3"/>
    </body>
  </worldbody>

  <equality>
    <!-- El terminal va atornillado a la brida de la muneca. Con solref="0.01 1"
         cedia 2,1 grados en SCAN_TILT_35 con una caja de 5 kg, lo que desplazaba
         la nube de esa vista casi 9 mm respecto a las otras dos. La constante de
         tiempo baja al doble del timestep, el minimo estable. -->
    <weld name="wrist_to_gripper" body1="wrist_3_link" body2="profiling_gripper" active="false"
          solref="0.004 1" solimp="0.99 0.9999 0.001 0.5 2"/>
    <weld name="gripper_to_box" body1="profiling_gripper" body2="profiling_box" active="false"
          solref="0.004 1" solimp="0.99 0.9999 0.001 0.5 2"/>
  </equality>
</mujoco>
